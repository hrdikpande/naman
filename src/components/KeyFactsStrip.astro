---
// Key facts strip — scannable facts a buyer scans for first (04-SERVICE-PAGE-TEMPLATE.md §5).
// Reuses neo.skill's dark stats-band visual language for real, sourced facts (not invented stats).
import type { KeyFact } from '../data/types';

interface Props {
  facts: KeyFact[];
}
const { facts } = Astro.props;
---

<section class="bg-ink text-white">
  <div class="mx-auto max-w-[1280px] px-4 md:px-8 py-10 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
    {
      facts.map((fact, i) => (
        <div class={i > 0 ? 'md:border-l md:border-white/15 md:pl-8' : ''}>
          <p class="text-yellow text-xs font-bold uppercase tracking-widest mb-2">{fact.label}</p>
          <p class="text-sm md:text-base font-medium text-white/90 leading-snug">{fact.value}</p>
        </div>
      ))
    }
  </div>
</section>
