---
// The process, step by step, including dispute/failure branches (04-SERVICE-PAGE-TEMPLATE.md §7).
// Deadlines surfaced prominently per 03-USER-EXPERIENCE.md urgency-handling rule.
import type { ProcessStep } from '../data/types';
import SectionTag from './SectionTag.astro';

interface Props {
  steps: ProcessStep[];
  heading?: string;
}
const { steps, heading = 'The Process' } = Astro.props;

const accents = ['bg-yellow', 'bg-cyan', 'bg-magenta', 'bg-green', 'bg-orange', 'bg-purple'];
---

{
  steps.length > 0 && (
    <section class="py-12 md:py-16">
      <div class="mx-auto max-w-[880px] px-4 md:px-8">
        <SectionTag>Process</SectionTag>
        <h2 class="mb-8">{heading}</h2>
        <ol class="flex flex-col gap-6">
          {steps.map((step, i) => (
            <li class="flex gap-4">
              <span
                class={`shrink-0 w-10 h-10 flex items-center justify-center border-[3px] border-ink rounded-brutal font-black text-sm ${accents[i % accents.length]} text-ink`}
                aria-hidden="true"
              >
                {step.step}
              </span>
              <div class="border-l-[3px] border-ink/10 pl-4 pb-1 last:border-transparent">
                <h3 class="text-base font-extrabold mb-1">{step.title}</h3>
                <p class="text-[#333] leading-relaxed">{step.description}</p>
                {step.deadline && (
                  <p class="mt-2 inline-flex items-center gap-1.5 bg-pastel-orange border-[3px] border-ink rounded-brutal px-3 py-1.5 text-xs font-bold uppercase tracking-wide">
                    <span aria-hidden="true">⏱</span> Deadline: {step.deadline}
                  </p>
                )}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}
