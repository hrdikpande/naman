---
// Input — neo.skill input spec + uiux.skill form accessibility (visible label, inline error near field).
interface Props {
  label: string;
  name: string;
  type?: 'text' | 'email' | 'tel';
  as?: 'input' | 'textarea' | 'select';
  required?: boolean;
  placeholder?: string;
  options?: { value: string; label: string }[];
  rows?: number;
  autocomplete?: string;
  value?: string;
}

const {
  label,
  name,
  type = 'text',
  as = 'input',
  required = false,
  placeholder,
  options = [],
  rows = 4,
  autocomplete,
  value,
} = Astro.props;

const fieldId = `field-${name}`;
const errorId = `${fieldId}-error`;

const fieldClass =
  'w-full border-[3px] border-ink rounded-brutal bg-white px-4 py-3 text-[15px] font-medium outline-none ' +
  'focus:shadow-brutal transition-shadow duration-100 aria-[invalid=true]:border-magenta aria-[invalid=true]:shadow-brutal-error';
---

<div class="flex flex-col gap-1.5" data-field={name}>
  <label for={fieldId} class="label-meta">
    {label}{required && <span class="text-magenta" aria-hidden="true"> *</span>}
  </label>

  {
    as === 'textarea' ? (
      <textarea
        id={fieldId}
        name={name}
        rows={rows}
        required={required}
        placeholder={placeholder}
        aria-describedby={errorId}
        class={fieldClass}
      >{value}</textarea>
    ) : as === 'select' ? (
      <select id={fieldId} name={name} required={required} aria-describedby={errorId} class={fieldClass}>
        {options.map((opt) => (
          <option value={opt.value} selected={opt.value === value}>
            {opt.label}
          </option>
        ))}
      </select>
    ) : (
      <input
        id={fieldId}
        name={name}
        type={type}
        required={required}
        placeholder={placeholder}
        autocomplete={autocomplete}
        value={value}
        aria-describedby={errorId}
        class={fieldClass}
      />
    )
  }
  <p id={errorId} class="text-magenta text-sm font-medium min-h-[1.25em]" data-error-for={name} role="alert"></p>
</div>
