---
// Full-bleed yellow CTA band before the footer (neo.skill CTA/Newsletter Bands spec).
import Button from './Button.astro';

interface Props {
  heading: string;
  body: string;
  buttonLabel: string;
  buttonHref: string;
}
const { heading, body, buttonLabel, buttonHref } = Astro.props;
---

<section class="bg-yellow border-y-[3px] border-ink">
  <div class="mx-auto max-w-[1280px] px-4 md:px-8 py-12 md:py-16 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
    <div class="max-w-2xl">
      <h2 class="mb-2">{heading}</h2>
      <p class="text-[#222] text-base md:text-lg">{body}</p>
    </div>
    <Button href={buttonHref} variant="dark" class="shrink-0">{buttonLabel}</Button>
  </div>
</section>
