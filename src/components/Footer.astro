---
// Footer — content from 02-NAVIGATION.md + 06-GLOBAL-CONTENT.md, visual spec from neo.skill.
import { footerColumns } from '../data/nav';
import { business, disclaimer } from '../data/business';

const year = new Date().getFullYear();
---

<footer class="bg-ink text-white">
  <div class="mx-auto max-w-[1280px] px-4 md:px-8 py-16 grid grid-cols-2 md:grid-cols-5 gap-8">
    <div class="col-span-2 md:col-span-1">
      <a href="/" class="flex items-center gap-2.5 mb-4">
        <span class="w-8 h-8 flex items-center justify-center bg-yellow border-[3px] border-white rounded-brutal font-black text-sm text-ink" aria-hidden="true">IP</span>
        <span class="font-extrabold uppercase tracking-tight text-sm">{business.displayName}</span>
      </a>
      <p class="text-sm text-white/70 mb-1">
        <a href={`mailto:${business.email}`} class="hover:text-white">{business.email}</a>
      </p>
      <p class="text-sm text-white/70">
        <a href={`tel:+91${business.phone}`} class="hover:text-white">{business.phoneDisplay}</a>
      </p>
      <p class="text-sm text-white/70 mt-2">
        <a href={business.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-white flex items-center gap-1.5">
          <span aria-hidden="true" class="text-lg leading-none">💼</span> LinkedIn
        </a>
      </p>
    </div>

    {
      footerColumns.map((col) => (
        <div>
          <h3 class="text-yellow uppercase text-xs font-bold tracking-widest mb-4">{col.title}</h3>
          <ul class="flex flex-col gap-2.5">
            {col.links.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-white/55 hover:text-white">
                  {link.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="border-t border-white/15">
    <div class="mx-auto max-w-[1280px] px-4 md:px-8 py-6">
      <p class="text-xs text-white/50 leading-relaxed max-w-4xl">{disclaimer}</p>
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mt-3">
        <p class="text-xs text-white/40">© {year} {business.displayName}. All rights reserved.</p>
        <p class="text-xs text-white/40">
          Built &amp; managed by&nbsp;<a
            href="https://latentiq.ai/"
            target="_blank"
            rel="noopener"
            class="latentiq-link font-semibold transition-all"
          >latentiq.ai</a>
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  .latentiq-link {
    color: #39ff14;
    text-shadow: 0 0 8px #39ff1480;
  }
  .latentiq-link:hover {
    color: #39ff14;
    text-shadow: 0 0 14px #39ff14, 0 0 28px #39ff1466;
  }
</style>
