---
// FAQ block — reused per page (06-GLOBAL-CONTENT.md), emits FAQPage schema (05-SEO-AND-GEO.md).
// Kept for AI/LLM citation value; Google retired FAQ rich results for all sites May 2026 (seo-doctor quality-gates).
import type { FAQItem } from '../data/types';
import SectionTag from './SectionTag.astro';
import JsonLd from './JsonLd.astro';
import { faqSchema } from '../lib/schema';

interface Props {
  items: FAQItem[];
  heading?: string;
}
const { items, heading = 'Frequently Asked Questions' } = Astro.props;
---

{
  items.length > 0 && (
    <section class="py-12 md:py-16">
      <div class="mx-auto max-w-[880px] px-4 md:px-8">
        <SectionTag>FAQ</SectionTag>
        <h2 class="mb-8">{heading}</h2>
        <div class="flex flex-col gap-4">
          {items.map((item) => (
            <details class="group border-[3px] border-ink rounded-brutal bg-white">
              <summary class="cursor-pointer list-none px-5 py-4 font-bold text-base flex items-center justify-between gap-4 [&::-webkit-details-marker]:hidden">
                {item.question}
                <span aria-hidden="true" class="shrink-0 transition-transform group-open:rotate-180">
                  ↓
                </span>
              </summary>
              <p class="px-5 pb-4 text-[#333] leading-relaxed">{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}

<JsonLd data={faqSchema(items)} />
