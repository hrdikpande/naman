---
// Disclaimer (/legal/disclaimer) — full version of the site-wide disclaimer (06-GLOBAL-CONTENT.md).
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionTag from '../../components/SectionTag.astro';
import { business, disclaimer } from '../../data/business';

const points = [
  `${business.displayName} provides IPR filing and facilitation services, not legal representation or legal advice, unless explicitly engaged for that specific purpose.`,
  'Registration outcomes depend entirely on the relevant government authority — IP India (for trademarks), the Copyright Office, or the Patent Office — and cannot be guaranteed by us or anyone else.',
  'Government fees and statutory timelines stated anywhere on this site are indicative and subject to change by the relevant authority. Always confirm current figures with us at enquiry stage.',
];
---

<BaseLayout
  title="Disclaimer"
  description={`Legal disclaimer for ${business.displayName} — services offered, no-guarantee statement on government outcomes, and fee/timeline accuracy.`}
  path="/legal/disclaimer"
>
  <Breadcrumbs items={[{ name: 'Disclaimer', href: '/legal/disclaimer' }]} />

  <section class="py-12 md:py-16">
    <div class="mx-auto max-w-[720px] px-4 md:px-8">
      <SectionTag>Legal</SectionTag>
      <h1 class="mb-6">Disclaimer</h1>
      <p class="text-[#333] leading-relaxed mb-8">{disclaimer}</p>
      <ul class="flex flex-col gap-4">
        {points.map((p) => (
          <li class="flex items-start gap-3 border-[3px] border-ink rounded-brutal bg-white p-5">
            <span class="shrink-0 w-[18px] h-[18px] mt-0.5 flex items-center justify-center bg-yellow border-2 border-ink rounded-sm text-[11px] font-bold" aria-hidden="true">!</span>
            <span class="text-[#333] text-sm leading-relaxed">{p}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
