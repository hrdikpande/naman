---
// Resources / Blog index (/resources) — supporting-pages.md. Top-of-funnel SEO + GEO.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionTag from '../../components/SectionTag.astro';
import Card from '../../components/Card.astro';

const articles = (await getCollection('resources')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const bgs = ['bg-pastel-yellow', 'bg-pastel-cyan', 'bg-pastel-pink', 'bg-pastel-green', 'bg-pastel-purple'];
---

<BaseLayout
  title="Resources — IPR Registration Guides"
  description="Plain-language guides on trademark, copyright, and patent registration in India — timelines, objections, provisional vs complete filing, and more."
  path="/resources"
>
  <Breadcrumbs items={[{ name: 'Resources', href: '/resources' }]} />

  <section class="py-12 md:py-16 border-b-[3px] border-ink">
    <div class="mx-auto max-w-[880px] px-4 md:px-8">
      <SectionTag>Resources</SectionTag>
      <h1 class="mb-5">Guides & Articles</h1>
      <p class="text-lg text-[#333] leading-relaxed max-w-2xl">
        Plain-language explainers on IPR registration in India — written to answer the questions you'd actually
        ask, whether that's a search engine or an AI assistant.
      </p>
    </div>
  </section>

  <section class="py-14 md:py-20 bg-white">
    <div class="mx-auto max-w-[1100px] px-4 md:px-8">
      <div class="grid sm:grid-cols-2 gap-5">
        {articles.map((article, i) => (
          <Card variant="accent" bgClass={bgs[i % bgs.length]} as="article">
            <h2 class="text-lg mb-2">{article.data.title}</h2>
            <p class="text-sm text-[#333] leading-relaxed mb-4">{article.data.description}</p>
            <a href={`/resources/${article.id}`} class="inline-flex items-center gap-1.5 font-bold text-sm">
              Read more <span aria-hidden="true">→</span>
            </a>
          </Card>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
