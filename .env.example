# Copy this file to .env for local overrides. Both variables are optional — the site builds and
# runs correctly with neither set. Never commit the real .env file (it's gitignored); this example
# file IS meant to be committed so contributors know what's configurable.

# Overrides the canonical/OG/sitemap base URL (astro.config.mjs). Defaults to the production
# domain (https://www.bhartiyaipsolutions.com) if unset — only set this for local/staging builds
# where you want canonical links to point somewhere else.
# PUBLIC_SITE_URL=https://www.bhartiyaipsolutions.com

# Google Search Console "HTML tag" ownership verification code (Settings > Ownership verification
# > HTML tag > just the `content` value, not the whole <meta> tag). Only renders a
# <meta name="google-site-verification"> tag when set — leave unset until the owner has one.
# PUBLIC_GOOGLE_SITE_VERIFICATION=

# Netlify Forms (the enquiry form's backend) needs no environment variable — it's detected
# automatically from the static HTML at deploy time. See netlify.toml and
# src/components/EnquiryForm.astro.
